# .env.example - COPY this file to ".env" (same folder) and replace every CHANGE_ME. Only this example is committed;
# ".env" holds real secrets and is listed in .gitignore. docker compose reads ".env" automatically.
#   cp .env.example .env

# Admin ("sa") password of the SQL Server container. SQL Server refuses weak passwords: at least 8 characters
# with 3 of: upper case, lower case, digits, symbols. Avoid ; ' " $ ` \ # and spaces (they are passed through shell commands and a connection string).
MSSQL_SA_PASSWORD=CHANGE_ME_Sa_Passw0rd

# The login the API itself uses (read/write rows only, cannot change the schema). Same character advice as above.
APP_DB_USER=bank_app
APP_DB_PASSWORD=CHANGE_ME_App_Passw0rd

# The API appends "_FullStackBank" to this name, so the real database is called Bank_FullStackBank.
DB_BASE_NAME=Bank

# true = insert the 3 demo customers (Asha, Ben, Chen) when the Customers table is empty. Use false for a real system.
SEED_DEMO_DATA=true

# The port on YOUR computer where the site appears: http://localhost:8080
WEB_PORT=8080
