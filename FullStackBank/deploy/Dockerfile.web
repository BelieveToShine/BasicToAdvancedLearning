# Dockerfile.web - the React app + the web server, as one image. Build context: the REPOSITORY ROOT (see docker-compose.yml);
# the .dockerignore file next to this one lets only frontend/ and nginx.conf into the build.
#
# Stage 1 (node) turns the React source into plain static files (HTML, JS, CSS). Stage 2 (nginx) serves those
# files and forwards /api requests to the API container. Node itself is NOT in the final image: a browser only needs
# the built files.

# ---- stage 1: build -------------------------------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app
# package.json + package-lock.json first, then `npm ci` (installs exactly the versions in the lock file): cached
# until your dependencies change.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Writes the finished site to /app/dist.
RUN npm run build

# ---- stage 2: serve -------------------------------------------------------------------------------------------
FROM nginx:alpine AS runtime
# Our config replaces the default site config. The nginx image reads every *.conf file in conf.d.
COPY FullStackBank/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
# nginx's own entrypoint starts it in the foreground; no CMD needed.
